TLS_KEY=${TWN_TOOLKIT_KEYFILE:-}
SCHEME=http
SERVICE_RUN_MODE=${TWN_TOOLKIT_SERVICE_RUN:-0}
SERVICE_RELOAD_REQUESTED=${TWN_TOOLKIT_RELOAD_SERVICE_LAUNCHER:-0}
UPGRADE_REQUEST_ID=${TWN_TOOLKIT_UPGRADE_REQUEST_ID:-}
SUPPRESS_TOOLKIT_START_EVENT=${TWN_TOOLKIT_SUPPRESS_START_EVENT:-0}
LAUNCHD_DIRECT_MODE=${TWN_TOOLKIT_LAUNCHD_DIRECT:-0}
LAUNCHD_ROLE=${TWN_TOOLKIT_LAUNCHD_ROLE:-}

if [ -z "$HOST" ] && [ -f "$SERVER_SETTINGS" ]; then
  HOST=$(python3 -c '
import json
import sys
try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        value = json.load(handle).get("listen_host", "127.0.0.1")
except (OSError, ValueError):
    value = "0.0.0.0"
print(value if value in {"127.0.0.1", "0.0.0.0"} else "0.0.0.0")
' "$SERVER_SETTINGS")
fi
HOST=${HOST:-0.0.0.0}
if [ -z "$PREFERRED_HOST" ] && [ -f "$SERVER_SETTINGS" ]; then
  PREFERRED_HOST=$(python3 -c '
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        print(str(json.load(handle).get("preferred_fqdn", "")).strip())
except (OSError, ValueError):
    print("")
' "$SERVER_SETTINGS")
fi
DISPLAY_HOST=${PREFERRED_HOST:-$HOST}
if [ "$DISPLAY_HOST" = "0.0.0.0" ]; then
  DISPLAY_HOST="127.0.0.1"
fi

load_running_endpoint() {
  if [ -z "$REQUESTED_HOST" ] && [ -f "$HOST_FILE" ]; then
    HOST=$(cat "$HOST_FILE")
  fi
  if [ -z "$REQUESTED_PORT" ] && [ -f "$PORT_FILE" ]; then
    PORT=$(cat "$PORT_FILE")
  fi
}

launchd_foreground_children() {
  [ "$SERVICE_RUN_MODE" = "1" ] \
    && [ "$(uname -s 2>/dev/null || echo unknown)" = "Darwin" ]
}

launchd_direct_job() {
  [ "$LAUNCHD_DIRECT_MODE" = "1" ] \
    && [ "$(uname -s 2>/dev/null || echo unknown)" = "Darwin" ]
}

launchd_direct_layout_installed() {
  [ "$(uname -s 2>/dev/null || echo unknown)" = "Darwin" ] \
    && [ -f "/Library/LaunchDaemons/com.thewifininja.toolkit.web.plist" ] \
    && [ -f "/Library/LaunchDaemons/com.thewifininja.toolkit.automation.plist" ] \
    && [ -f "/Library/LaunchDaemons/com.thewifininja.toolkit.supervisor.plist" ]
}

launchd_managed_jobs_available() {
  launchd_direct_job && service_launcher_is_running
}

show_access_urls() {
  "$PYTHON" -c '
import ipaddress
import re
import socket
import subprocess
import sys

scheme, host, port, preferred = sys.argv[1:]
addresses = set()

def add(value):
    value = value.strip()
    try:
        address = ipaddress.ip_address(value)
    except ValueError:
        return
    if address.version == 4 and not address.is_unspecified and not address.is_multicast and not address.is_link_local:
        addresses.add(str(address))

if host == "0.0.0.0":
    for command in (("ip", "-o", "-4", "addr", "show", "up"), ("ifconfig",)):
        try:
            output = subprocess.run(command, capture_output=True, text=True, timeout=3, check=True).stdout
        except (FileNotFoundError, OSError, subprocess.SubprocessError):
            continue
        pattern = r"\binet\s+(\d+\.\d+\.\d+\.\d+)"
        for match in re.findall(pattern, output):
            add(match)
    try:
        for answer in socket.getaddrinfo(socket.gethostname(), None, socket.AF_INET):
            add(answer[4][0])
    except socket.gaierror:
        pass
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as probe:
            probe.connect(("192.0.2.1", 9))
            add(probe.getsockname()[0])
    except OSError:
        pass
else:
    add(host)

ordered = sorted((value for value in addresses if value != "127.0.0.1"), key=ipaddress.ip_address)
ordered.append("127.0.0.1")
urls = []
if preferred:
    urls.append(f"{scheme}://{preferred}:{port}")
urls.extend(f"{scheme}://{address}:{port}" for address in ordered)
urls = list(dict.fromkeys(urls))
print("Toolkit access URLs:")
for url in urls:
    print(f"  {url}")
' "$SCHEME" "$HOST" "$PORT" "$PREFERRED_HOST"
}

configure_tls() {
  if { [ -n "$TLS_CERT" ] && [ -z "$TLS_KEY" ]; } || { [ -z "$TLS_CERT" ] && [ -n "$TLS_KEY" ]; }; then
    echo "Set both TWN_TOOLKIT_CERTFILE and TWN_TOOLKIT_KEYFILE, or neither." >&2
    exit 1
  fi
  if [ -z "$TLS_CERT" ] && [ -f "$TLS_ENABLED_FILE" ]; then
    TLS_CERT="$TLS_CERT_DEFAULT"
    TLS_KEY="$TLS_KEY_DEFAULT"
  fi
  if [ -n "$TLS_CERT" ]; then
    if ! "$PYTHON" -c 'from twn_toolkit.tls_tools import validate_certificate_pair; import sys; validate_certificate_pair(sys.argv[1], sys.argv[2])' "$TLS_CERT" "$TLS_KEY"; then
      echo "HTTPS is enabled, but its certificate or private key is invalid." >&2
      echo "Run: ./twn disable-https" >&2
      exit 1
    fi
    SCHEME=https
  fi
}

pid_is_running() {
  [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null || return 1
  if [ -r "/proc/$1/stat" ]; then
    pid_state=$(cat "/proc/$1/stat" 2>/dev/null || true)
    pid_state=${pid_state##*) }
    case "$pid_state" in
      Z\ *|X\ *) return 1 ;;
    esac
  fi
  return 0
}

is_running() {
  [ -f "$PIDFILE" ] && pid_is_running "$(cat "$PIDFILE")"
}

automation_is_running() {
  [ -f "$AUTOMATION_PIDFILE" ] && pid_is_running "$(cat "$AUTOMATION_PIDFILE")"
}

supervisor_is_running() {
  [ -f "$SUPERVISOR_PIDFILE" ] && pid_is_running "$(cat "$SUPERVISOR_PIDFILE")"
}

service_launcher_is_running() {
  [ -f "$SERVICE_LAUNCHER_PIDFILE" ] && pid_is_running "$(cat "$SERVICE_LAUNCHER_PIDFILE")"
}

deferred_service_reload_is_running() {
  [ -f "$SERVICE_DEFERRED_RELOAD_PIDFILE" ] \
    && pid_is_running "$(cat "$SERVICE_DEFERRED_RELOAD_PIDFILE" 2>/dev/null || true)"
}

service_boot_generation() {
  "$PYTHON" -c 'import time; print(max(0, int((time.time() - time.monotonic()) // 10) * 10))'
}

write_service_pause_marker() {
  mkdir -p "$INSTANCE"
  service_boot_generation > "$SERVICE_PAUSE_FILE"
  chmod 600 "$SERVICE_PAUSE_FILE"
  rm -f "$SERVICE_LAUNCHD_MARKER" \
    "$TFTP_LAUNCHD_MARKER" "$SSH_TRANSFER_LAUNCHD_MARKER" "$FTP_LAUNCHD_MARKER"
}

clear_stale_direct_service_pause() {
  [ -f "$SERVICE_PAUSE_FILE" ] || return 0
  paused_boot_generation=$(cat "$SERVICE_PAUSE_FILE" 2>/dev/null || true)
  [ -n "$paused_boot_generation" ] || return 0
  current_boot_generation=$(service_boot_generation)
  if [ "$paused_boot_generation" != "$current_boot_generation" ]; then
    rm -f "$SERVICE_PAUSE_FILE"
  fi
}

upgrade_worker_is_ancestor() {
  ancestor_pid=${PPID:-}
  ancestor_hops=0
  while [ "$ancestor_hops" -lt 12 ]; do
    case "$ancestor_pid" in
      ""|*[!0-9]*) return 1 ;;
    esac
    [ "$ancestor_pid" -gt 1 ] || return 1
    ancestor_command=$(ps -o command= -p "$ancestor_pid" 2>/dev/null || true)
    case "$ancestor_command" in
      *twn_toolkit.upgrade_worker*) return 0 ;;
    esac
    ancestor_pid=$(ps -o ppid= -p "$ancestor_pid" 2>/dev/null | tr -d ' ' || true)
    ancestor_hops=$((ancestor_hops + 1))
  done
  return 1
}

upgrade_reload_should_be_deferred() {
  [ -f "$UPGRADE_OPERATION_LOCK" ] || return 1
  active_request_id=$(cat "$UPGRADE_OPERATION_LOCK" 2>/dev/null || true)
  [ -n "$active_request_id" ] || return 1
  if [ -n "$UPGRADE_REQUEST_ID" ]; then
    [ "$UPGRADE_REQUEST_ID" = "$active_request_id" ]
    return
  fi
  upgrade_worker_is_ancestor
}

upgrade_from_version() {
  "$PYTHON" -c '
import json, sys
try:
    value = json.load(open(sys.argv[1], encoding="utf-8"))
    print(str(value.get("from_version", "")))
except (OSError, ValueError):
    print("")
' "$UPGRADE_STATUS_FILE"
}

installed_source_version() {
  "$PYTHON" -c '
import re, sys
try:
    source = open(sys.argv[1], encoding="utf-8").read()
except OSError:
    print("")
else:
    match = re.search(r"^APP_VERSION\s*=\s*[\"\x27]([^\"\x27]+)", source, re.MULTILINE)
    print(match.group(1) if match else "")
' "$ROOT/twn_toolkit/version.py"
}

restore_deferred_service_launcher() {
  deferred_launcher_pid="$1"
  if pid_is_running "$deferred_launcher_pid"; then
    printf "%s\n" "$deferred_launcher_pid" > "$SERVICE_LAUNCHER_PIDFILE"
    chmod 600 "$SERVICE_LAUNCHER_PIDFILE"
  fi
  rm -f "$SERVICE_PAUSE_FILE" "$SERVICE_RESUME_FILE"
}

withhold_deferred_service_launcher() {
  # Do not recreate the path during the brief atomic instance-directory swap
  # performed by rollback; the restored instance already contains the pause.
  [ -d "$INSTANCE" ] || return
  write_service_pause_marker
  rm -f "$SERVICE_LAUNCHER_PIDFILE" "$SERVICE_RESUME_FILE"
}

deferred_service_reload() {
  deferred_launcher_pid="$1"
  deferred_request_id="$2"
  deferred_from_version="$3"
  trap 'rm -f "$SERVICE_DEFERRED_RELOAD_PIDFILE"' EXIT
  trap 'exit 1' INT TERM
  trap '' HUP

  deferred_attempts=0
  while :; do
    while [ -f "$UPGRADE_OPERATION_LOCK" ] && [ "$deferred_attempts" -lt 600 ]; do
      # A matched instance restore can reintroduce the PID file captured in its
      # recovery point. Keep discovery withheld so even an older restored twn
      # starts validation directly instead of reloading the service too early.
      withhold_deferred_service_launcher
      deferred_attempts=$((deferred_attempts + 1))
      sleep 1
    done
    if [ -f "$UPGRADE_OPERATION_LOCK" ]; then
      echo "Deferred service reload for $deferred_request_id timed out; retaining the validated process set." >&2
      restore_deferred_service_launcher "$deferred_launcher_pid"
      return 1
    fi

    # v0.16.2 removed the operation lock just before its final request cleanup.
    # Later workers remove it last. This grace period safely covers both orders,
    # and the recheck avoids reloading during a newly queued operation.
    sleep 2
    [ -f "$UPGRADE_OPERATION_LOCK" ] || break
  done
  deferred_installed_version=$(installed_source_version || true)
  if [ -n "$deferred_from_version" ] \
    && [ "$deferred_installed_version" = "$deferred_from_version" ] \
    && pid_is_running "$deferred_launcher_pid" \
    && is_running && automation_is_running && supervisor_is_running; then
    echo "Upgrade operation $deferred_request_id restored v$deferred_from_version; the original service launcher is adopting the validated rollback."
    restore_deferred_service_launcher "$deferred_launcher_pid"
    return
  fi

  echo "Upgrade operation $deferred_request_id finalized; requesting an OS-managed launcher reload."
  TWN_TOOLKIT_SERVICE_RUN=1 \
    TWN_TOOLKIT_RELOAD_SERVICE_LAUNCHER=0 \
    "$ROOT/twn" stop || true
  rm -f "$SERVICE_PAUSE_FILE" "$SERVICE_RESUME_FILE"
  if launchd_direct_layout_installed; then
    wait_for_direct_process_set || \
      echo "The direct launchd process set did not recreate every runtime marker after reload." >&2
  fi
}

schedule_deferred_service_reload() {
  deferred_launcher_pid="$1"
  deferred_request_id="$2"
  deferred_from_version="$3"
  if [ -f "$SERVICE_DEFERRED_RELOAD_PIDFILE" ]; then
    deferred_existing_pid=$(cat "$SERVICE_DEFERRED_RELOAD_PIDFILE" 2>/dev/null || true)
    if pid_is_running "$deferred_existing_pid"; then
      echo "A deferred service reload is already monitoring upgrade $deferred_request_id." >&2
      return 1
    fi
    rm -f "$SERVICE_DEFERRED_RELOAD_PIDFILE"
  fi
  (
    deferred_service_reload \
      "$deferred_launcher_pid" "$deferred_request_id" "$deferred_from_version"
  ) </dev/null >> "$SERVICE_RELOAD_LOG" 2>&1 &
  deferred_helper_pid=$!
  printf "%s\n" "$deferred_helper_pid" > "$SERVICE_DEFERRED_RELOAD_PIDFILE"
  chmod 600 "$SERVICE_DEFERRED_RELOAD_PIDFILE"
}

arm_deferred_service_reload() {
  deferred_launcher_pid="$1"
  deferred_request_id="$2"
  deferred_from_version="$3"
  withhold_deferred_service_launcher
  if ! schedule_deferred_service_reload \
    "$deferred_launcher_pid" "$deferred_request_id" "$deferred_from_version"; then
    restore_deferred_service_launcher "$deferred_launcher_pid"
    return 1
  fi
}

prepare_upgrade_service_reload() {
  if ! upgrade_reload_should_be_deferred; then
    echo "A matching active upgrade operation was not found." >&2
    return 1
  fi
  deferred_launcher_pid=$(cat "$SERVICE_LAUNCHER_PIDFILE" 2>/dev/null || true)
  if [ -z "$deferred_launcher_pid" ] || ! pid_is_running "$deferred_launcher_pid"; then
    echo "No boot-managed launcher needs a deferred reload."
    return 3
  fi
  deferred_request_id=$(cat "$UPGRADE_OPERATION_LOCK" 2>/dev/null || true)
  deferred_from_version=$(upgrade_from_version || true)
  arm_deferred_service_reload \
    "$deferred_launcher_pid" "$deferred_request_id" "$deferred_from_version"
  echo "The boot-managed launcher will reload after upgrade finalization."
}

request_service_start() {
  rm -f "$SERVICE_PAUSE_FILE"
  : > "$SERVICE_RESUME_FILE"
  attempts=0
  while [ "$attempts" -lt 1800 ]; do
    if is_running && automation_is_running && supervisor_is_running \
      && [ -f "$SCHEME_FILE" ] && [ -f "$HOST_FILE" ] && [ -f "$PORT_FILE" ]; then
      rm -f "$SERVICE_RESUME_FILE"
      load_running_endpoint
      if [ -f "$SCHEME_FILE" ]; then SCHEME=$(cat "$SCHEME_FILE"); fi
      echo "The autostart service started The WiFi Ninja's Toolkit (PID $(cat "$PIDFILE"))."
      show_access_urls
      return
    fi
    if ! service_launcher_is_running; then
      echo "The autostart service exited before the toolkit started." >&2
      return 1
    fi
    attempts=$((attempts + 1))
    sleep 0.1
  done
  echo "Timed out waiting for the autostart service to start the toolkit." >&2
  return 1
}

request_service_reload() {
  previous_launcher_pid=$(cat "$SERVICE_LAUNCHER_PIDFILE" 2>/dev/null || true)
  if [ -z "$previous_launcher_pid" ]; then
    echo "The autostart service launcher PID could not be read." >&2
    return 1
  fi

  # A paused launcher exits unsuccessfully when its pause is cleared while the
  # managed web process is stopped. systemd/launchd then starts a fresh copy of
  # this script from disk, which is required after an upgrade replaces `twn`.
  if launchd_direct_layout_installed; then
    rm -f "$SERVICE_LAUNCHER_PIDFILE"
  fi
  rm -f "$SERVICE_PAUSE_FILE" "$SERVICE_RESUME_FILE"
  attempts=0
  while [ "$attempts" -lt 1800 ]; do
    if service_launcher_is_running; then
      current_launcher_pid=$(cat "$SERVICE_LAUNCHER_PIDFILE" 2>/dev/null || true)
      if [ -n "$current_launcher_pid" ] \
        && [ "$current_launcher_pid" != "$previous_launcher_pid" ] \
        && is_running && automation_is_running && supervisor_is_running \
        && [ -f "$SCHEME_FILE" ] && [ -f "$HOST_FILE" ] && [ -f "$PORT_FILE" ]; then
        load_running_endpoint
        if [ -f "$SCHEME_FILE" ]; then SCHEME=$(cat "$SCHEME_FILE"); fi
        echo "The autostart service reloaded the updated toolkit launcher (PID $current_launcher_pid)."
        show_access_urls
        return
      fi
    fi
    attempts=$((attempts + 1))
    sleep 0.1
  done
  echo "Timed out waiting for the OS service manager to reload the toolkit launcher." >&2
  echo "Inspect: ./twn service status && ./twn service logs" >&2
  return 1
}

request_deferred_service_reload() {
  deferred_launcher_pid=$(cat "$SERVICE_LAUNCHER_PIDFILE" 2>/dev/null || true)
  deferred_request_id=$(cat "$UPGRADE_OPERATION_LOCK" 2>/dev/null || true)
  deferred_from_version=$(upgrade_from_version || true)
  if [ -z "$deferred_launcher_pid" ] || [ -z "$deferred_request_id" ]; then
    echo "The active upgrade or service launcher could not be identified." >&2
    return 1
  fi

  # This is the compatibility bridge for an upgrade launched by v0.16.2, whose
  # worker cannot prepare the handoff before replacing application files.
  if ! arm_deferred_service_reload \
    "$deferred_launcher_pid" "$deferred_request_id" "$deferred_from_version"; then
    return 1
  fi

  # Start the target process set directly while the old OS launcher remains
  # paused. Do not record a toolkit-start event for this validation-only start;
  # the final OS-managed launcher records the one real post-upgrade event.
  deferred_start_failed=0
  if ! TWN_TOOLKIT_LAUNCHD_DIRECT=0 \
    TWN_TOOLKIT_SERVICE_RUN=1 \
    TWN_TOOLKIT_RELOAD_SERVICE_LAUNCHER=0 \
    TWN_TOOLKIT_SUPPRESS_START_EVENT=1 \
    "$ROOT/twn" start; then
    deferred_start_failed=1
  fi

  if [ "$deferred_start_failed" -eq 1 ]; then
    return 1
  fi

  load_running_endpoint
  if [ -f "$SCHEME_FILE" ]; then SCHEME=$(cat "$SCHEME_FILE"); fi
  echo "The target process set is ready; the OS service launcher will reload after upgrade finalization."
  show_access_urls
}

managed_worker_is_running() {
  [ -f "$1" ] && pid_is_running "$(cat "$1")"
}

managed_worker_is_ready() {
  [ -f "$1" ] && [ -f "$2" ] || return 1
  worker_pid=$(cat "$1" 2>/dev/null || true)
  ready_pid=$(cat "$2" 2>/dev/null || true)
  [ -n "$worker_pid" ] && [ "$worker_pid" = "$ready_pid" ] && pid_is_running "$worker_pid"
}

managed_worker_enabled() {
  [ -f "$1" ] || return 1
  "$PYTHON" -c 'import json, sys; raise SystemExit(0 if json.load(open(sys.argv[1], encoding="utf-8")).get("enabled") else 1)' "$1" >/dev/null 2>&1
}

launchd_marker_for_pidfile() {
  case "$1" in
    "$TFTP_PIDFILE") echo "$TFTP_LAUNCHD_MARKER" ;;
    "$SSH_TRANSFER_PIDFILE") echo "$SSH_TRANSFER_LAUNCHD_MARKER" ;;
    "$FTP_PIDFILE") echo "$FTP_LAUNCHD_MARKER" ;;
    *) return 1 ;;
  esac
}

sync_launchd_transfer_markers() {
  launchd_direct_job || return 0
  if [ -f "$SERVICE_PAUSE_FILE" ]; then
    rm -f "$SERVICE_LAUNCHD_MARKER" \
      "$TFTP_LAUNCHD_MARKER" "$SSH_TRANSFER_LAUNCHD_MARKER" "$FTP_LAUNCHD_MARKER"
    return 0
  fi
  : > "$SERVICE_LAUNCHD_MARKER"
  if managed_worker_enabled "$TFTP_SETTINGS"; then : > "$TFTP_LAUNCHD_MARKER"; else rm -f "$TFTP_LAUNCHD_MARKER"; fi
  if managed_worker_enabled "$SSH_TRANSFER_SETTINGS"; then : > "$SSH_TRANSFER_LAUNCHD_MARKER"; else rm -f "$SSH_TRANSFER_LAUNCHD_MARKER"; fi
  if managed_worker_enabled "$FTP_SETTINGS"; then : > "$FTP_LAUNCHD_MARKER"; else rm -f "$FTP_LAUNCHD_MARKER"; fi
  chmod 600 "$SERVICE_LAUNCHD_MARKER" \
    "$TFTP_LAUNCHD_MARKER" "$SSH_TRANSFER_LAUNCHD_MARKER" "$FTP_LAUNCHD_MARKER" \
    2>/dev/null || true
}

acquire_managed_worker_lock() {
  worker_lock="$1.lock"
  attempts=0
  while ! mkdir "$worker_lock" 2>/dev/null; do
    lock_owner=""
    if [ -f "$worker_lock/owner" ]; then lock_owner=$(cat "$worker_lock/owner" 2>/dev/null || true); fi
    if [ -n "$lock_owner" ] && ! pid_is_running "$lock_owner"; then
      rm -f "$worker_lock/owner"
      rmdir "$worker_lock" 2>/dev/null || true
      continue
    fi
    attempts=$((attempts + 1))
    if [ -z "$lock_owner" ] && [ "$attempts" -ge 10 ]; then
      rmdir "$worker_lock" 2>/dev/null || true
      continue
    fi
    if [ "$attempts" -ge 100 ]; then
      echo "Another managed-service operation is still in progress." >&2
      return 1
    fi
    sleep 0.1
  done
  echo "$$" > "$worker_lock/owner"
}

release_managed_worker_lock() {
  worker_lock="$1.lock"
  rm -f "$worker_lock/owner"
  rmdir "$worker_lock" 2>/dev/null || true
}

clear_managed_runtime() {
  if [ -x "$PYTHON" ]; then
    "$PYTHON" -c 'import importlib, sys; module, function = sys.argv[1].split(":", 1); getattr(importlib.import_module(module), function)(sys.argv[2])' "$1" "$INSTANCE"
  fi
}

stop_managed_worker_unlocked() {
  worker_pidfile=$1
  worker_readyfile=$2
  cleanup=$3
  if launchd_managed_jobs_available; then
    worker_launchd_marker=$(launchd_marker_for_pidfile "$worker_pidfile" 2>/dev/null || true)
    if [ -n "$worker_launchd_marker" ]; then rm -f "$worker_launchd_marker"; fi
  fi
  if ! managed_worker_is_running "$worker_pidfile"; then
    rm -f "$worker_pidfile"
    rm -f "$worker_readyfile"
    clear_managed_runtime "$cleanup"
    return
  fi
  worker_pid=$(cat "$worker_pidfile")
  kill "$worker_pid"
  attempts=0
  while pid_is_running "$worker_pid" && [ "$attempts" -lt 50 ]; do attempts=$((attempts + 1)); sleep 0.1; done
  if pid_is_running "$worker_pid"; then kill -KILL "$worker_pid" 2>/dev/null || true; fi
  rm -f "$worker_pidfile"
  rm -f "$worker_readyfile"
  clear_managed_runtime "$cleanup"
}

stop_managed_worker() {
  worker_pidfile=$1
  worker_readyfile=$2
  cleanup=$3
  worker_module=$4
  acquire_managed_worker_lock "$worker_pidfile"
  status=0
  stop_managed_worker_unlocked "$worker_pidfile" "$worker_readyfile" "$cleanup" || status=$?
  if [ "$status" -eq 0 ]; then cleanup_worker_processes "$worker_module" 0 || status=$?; fi
  release_managed_worker_lock "$worker_pidfile"
  return "$status"
}

start_managed_worker_unlocked() {
  settings_file=$1
  worker_pidfile=$2
  worker_readyfile=$3
  worker_log=$4
  worker_module=$5
  worker_label=$6
  cleanup=$7
  if ! managed_worker_enabled "$settings_file"; then
    stop_managed_worker_unlocked "$worker_pidfile" "$worker_readyfile" "$cleanup"
    return 0
  fi
  if managed_worker_is_ready "$worker_pidfile" "$worker_readyfile"; then return 0; fi
  if managed_worker_is_running "$worker_pidfile"; then
    stop_managed_worker_unlocked "$worker_pidfile" "$worker_readyfile" "$cleanup"
  fi
  rm -f "$worker_pidfile"
  rm -f "$worker_readyfile"
  cd "$ROOT"
  worker_log_start=0
  if [ -f "$worker_log" ]; then worker_log_start=$(wc -l < "$worker_log" | tr -d ' '); fi
  if launchd_managed_jobs_available; then
    worker_launchd_marker=$(launchd_marker_for_pidfile "$worker_pidfile")
    : > "$worker_launchd_marker"
    chmod 600 "$worker_launchd_marker"
  elif launchd_foreground_children; then
    "$PYTHON" -m "$worker_module" \
      --instance "$INSTANCE" \
      --pid-file "$worker_pidfile" \
      --ready-file "$worker_readyfile" \
      --log-file "$worker_log" \
      </dev/null >> "$worker_log" 2>&1 &
  else
    if ! "$PYTHON" -m "$worker_module" --instance "$INSTANCE" --daemon --pid-file "$worker_pidfile" --ready-file "$worker_readyfile" --log-file "$worker_log"; then
      echo "The $worker_label service launcher failed before daemon startup." >&2
      return 1
    fi
  fi
  attempts=0
  while [ "$attempts" -lt 100 ]; do
    if managed_worker_is_ready "$worker_pidfile" "$worker_readyfile"; then return 0; fi
    if [ -f "$worker_pidfile" ] && ! managed_worker_is_running "$worker_pidfile"; then break; fi
    attempts=$((attempts + 1)); sleep 0.1
  done
  echo "The $worker_label service did not start. Check: $worker_log" >&2
  worker_error=$(tail -n "+$((worker_log_start + 1))" "$worker_log" 2>/dev/null | awk 'NF {message=$0} END{print message}')
  if [ -n "$worker_error" ]; then
    echo "$worker_error" >&2
  else
    echo "The worker exited before socket readiness and did not write a startup error." >&2
  fi
  if managed_worker_is_running "$worker_pidfile"; then
    stop_managed_worker_unlocked "$worker_pidfile" "$worker_readyfile" "$cleanup"
  fi
  return 1
}

start_managed_worker() {
  settings_file=$1
  worker_pidfile=$2
  worker_readyfile=$3
  worker_log=$4
  worker_module=$5
  worker_label=$6
  cleanup=$7
  acquire_managed_worker_lock "$worker_pidfile"
  status=0
  cleanup_managed_daemon "$worker_module" "$worker_pidfile" || status=$?
  if [ "$status" -eq 0 ]; then
    start_managed_worker_unlocked "$settings_file" "$worker_pidfile" "$worker_readyfile" "$worker_log" "$worker_module" "$worker_label" "$cleanup" || status=$?
  fi
  release_managed_worker_lock "$worker_pidfile"
  return "$status"
}

restart_managed_worker() {
  settings_file=$1
  worker_pidfile=$2
  worker_readyfile=$3
  worker_log=$4
  worker_module=$5
  worker_label=$6
  cleanup=$7
  acquire_managed_worker_lock "$worker_pidfile"
  status=0
  stop_managed_worker_unlocked "$worker_pidfile" "$worker_readyfile" "$cleanup" || status=$?
  if [ "$status" -eq 0 ]; then cleanup_daemon_processes "$worker_module" 0 || status=$?; fi
  if [ "$status" -eq 0 ]; then
    start_managed_worker_unlocked "$settings_file" "$worker_pidfile" "$worker_readyfile" "$worker_log" "$worker_module" "$worker_label" "$cleanup" || status=$?
  fi
  release_managed_worker_lock "$worker_pidfile"
  return "$status"
}

tftp_is_running() { managed_worker_is_ready "$TFTP_PIDFILE" "$TFTP_READYFILE"; }
tftp_enabled() { managed_worker_enabled "$TFTP_SETTINGS"; }
start_tftp() { start_managed_worker "$TFTP_SETTINGS" "$TFTP_PIDFILE" "$TFTP_READYFILE" "$TFTP_LOG" "twn_toolkit.tftp_worker" "TFTP" "twn_toolkit.tftp:clear_tftp_runtime"; }
stop_tftp() { stop_managed_worker "$TFTP_PIDFILE" "$TFTP_READYFILE" "twn_toolkit.tftp:clear_tftp_runtime" "twn_toolkit.tftp_worker"; }

ssh_transfer_is_running() { managed_worker_is_ready "$SSH_TRANSFER_PIDFILE" "$SSH_TRANSFER_READYFILE"; }
ssh_transfer_enabled() { managed_worker_enabled "$SSH_TRANSFER_SETTINGS"; }
start_ssh_transfer() { start_managed_worker "$SSH_TRANSFER_SETTINGS" "$SSH_TRANSFER_PIDFILE" "$SSH_TRANSFER_READYFILE" "$SSH_TRANSFER_LOG" "twn_toolkit.ssh_transfer_worker" "SSH transfer" "twn_toolkit.ssh_transfer_server:clear_ssh_transfer_runtime"; }
stop_ssh_transfer() { stop_managed_worker "$SSH_TRANSFER_PIDFILE" "$SSH_TRANSFER_READYFILE" "twn_toolkit.ssh_transfer_server:clear_ssh_transfer_runtime" "twn_toolkit.ssh_transfer_worker"; }

ftp_is_running() { managed_worker_is_ready "$FTP_PIDFILE" "$FTP_READYFILE"; }
ftp_enabled() { managed_worker_enabled "$FTP_SETTINGS"; }
start_ftp() { start_managed_worker "$FTP_SETTINGS" "$FTP_PIDFILE" "$FTP_READYFILE" "$FTP_LOG" "twn_toolkit.ftp_worker" "FTP" "twn_toolkit.ftp_server:clear_ftp_runtime"; }
stop_ftp() { stop_managed_worker "$FTP_PIDFILE" "$FTP_READYFILE" "twn_toolkit.ftp_server:clear_ftp_runtime" "twn_toolkit.ftp_worker"; }

start_transfer_services() {
  tftp_started=0
  ssh_transfer_started=0
  ftp_started=0
  if launchd_foreground_children; then
    if start_tftp; then tftp_started=1; fi
    if start_ssh_transfer; then ssh_transfer_started=1; fi
    if start_ftp; then ftp_started=1; fi
    return 0
  fi
  start_tftp &
  tftp_start_job=$!
  start_ssh_transfer &
  ssh_transfer_start_job=$!
  start_ftp &
  ftp_start_job=$!
  if wait "$tftp_start_job"; then tftp_started=1; fi
  if wait "$ssh_transfer_start_job"; then ssh_transfer_started=1; fi
  if wait "$ftp_start_job"; then ftp_started=1; fi
  return 0
}

stop_transfer_services() {
  transfer_stop_status=0
  stop_tftp &
  tftp_stop_job=$!
  stop_ssh_transfer &
  ssh_transfer_stop_job=$!
  stop_ftp &
  ftp_stop_job=$!
  wait "$tftp_stop_job" || transfer_stop_status=$?
  wait "$ssh_transfer_stop_job" || transfer_stop_status=$?
  wait "$ftp_stop_job" || transfer_stop_status=$?
  return "$transfer_stop_status"
}

cleanup_daemon_processes() {
  daemon_module=$1
  daemon_keep_pid=$2
  if [ ! -x "$PYTHON" ]; then return; fi
  "$PYTHON" -c '
from pathlib import Path
import sys
from twn_toolkit.pidfiles import stop_matching_daemons
stop_matching_daemons(sys.argv[1], Path(sys.argv[2]), keep_pid=int(sys.argv[3]))
' "$daemon_module" "$INSTANCE" "$daemon_keep_pid"
}

cleanup_worker_processes() {
  worker_module=$1
  worker_keep_pid=$2
  worker_required_text=${3:-}
  if [ ! -x "$PYTHON" ]; then return; fi
  "$PYTHON" -c '
from pathlib import Path
import sys
from twn_toolkit.pidfiles import stop_matching_workers
stop_matching_workers(
    sys.argv[1],
    Path(sys.argv[2]),
    keep_pid=int(sys.argv[3]),
    required_text=sys.argv[4],
)
' "$worker_module" "$INSTANCE" "$worker_keep_pid" "$worker_required_text"
}

cleanup_managed_daemon() {
  daemon_module=$1
  daemon_pidfile=$2
  daemon_keep_pid=0
  if managed_worker_is_running "$daemon_pidfile"; then daemon_keep_pid=$(cat "$daemon_pidfile"); fi
  cleanup_worker_processes "$daemon_module" "$daemon_keep_pid"
}

start_automation() {
  if automation_is_running; then
    cleanup_worker_processes "twn_toolkit.automation_worker" "$(cat "$AUTOMATION_PIDFILE")"
    return
  fi
  cleanup_worker_processes "twn_toolkit.automation_worker" 0
  rm -f "$AUTOMATION_PIDFILE"
  cd "$ROOT"
  if launchd_managed_jobs_available; then
    : # launchd restarts the direct scheduler job after its PID disappears.
  elif launchd_foreground_children; then
    "$PYTHON" -m twn_toolkit.automation_worker \
      --instance "$INSTANCE" \
      --pid-file "$AUTOMATION_PIDFILE" \
      --log-file "$AUTOMATION_LOG" \
      </dev/null >> "$AUTOMATION_LOG" 2>&1 &
  else
    "$PYTHON" -m twn_toolkit.automation_worker \
      --instance "$INSTANCE" \
      --daemon \
      --pid-file "$AUTOMATION_PIDFILE" \
      --log-file "$AUTOMATION_LOG"
  fi
  attempts=0
  while [ "$attempts" -lt 20 ]; do
    if automation_is_running; then
      return
    fi
    attempts=$((attempts + 1))
    sleep 0.1
  done
  echo "The automation scheduler did not start. Check: $AUTOMATION_LOG" >&2
  return 1
}

stop_automation() {
  if ! automation_is_running; then
    rm -f "$AUTOMATION_PIDFILE"
    cleanup_worker_processes "twn_toolkit.automation_worker" 0
    return
  fi
  automation_pid=$(cat "$AUTOMATION_PIDFILE")
  kill "$automation_pid" 2>/dev/null || true
  attempts=0
  while pid_is_running "$automation_pid" && [ "$attempts" -lt 50 ]; do
    attempts=$((attempts + 1))
    sleep 0.1
  done
  if pid_is_running "$automation_pid"; then
    kill -KILL "$automation_pid" 2>/dev/null || true
  fi
  rm -f "$AUTOMATION_PIDFILE"
  cleanup_worker_processes "twn_toolkit.automation_worker" 0
}

stop_packet_captures() {
  cleanup_daemon_processes "twn_toolkit.packet_capture_worker" 0
}

start_iperf_servers() {
