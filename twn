recover() {
  if [ ! -x "$PYTHON" ]; then
    echo "Python virtual environment is missing. Run: ./install.sh" >&2
    exit 1
  fi

  load_running_endpoint
  host_os=$(uname -s 2>/dev/null || echo unknown)
  echo "Recovering The WiFi Ninja's Toolkit on $host_os..."

  server_pids=$(recovery_server_pids)
  listener_pids=$(recovery_listener_pids)
  if [ "$(id -u)" -ne 0 ]; then
    if has_runtime_permission_issues; then
      elevate_recovery
    fi
    for server_pid in $server_pids; do
      if ! pid_is_running "$server_pid"; then
        elevate_recovery
      fi
    done
    if [ -z "$listener_pids" ] && ! port_available; then
      elevate_recovery
    fi
  fi

  if [ -z "$listener_pids" ] && ! port_available; then
    echo "Cannot recover safely: $HOST:$PORT is in use by another application." >&2
    show_recovery_listeners
    echo "No unrelated process was stopped." >&2
    exit 1
  fi

  if [ -f "$PIDFILE" ]; then
    recorded_pid=$(cat "$PIDFILE" 2>/dev/null || true)
    pidfile_verified=0
    for server_pid in $server_pids; do
      if [ "$server_pid" = "$recorded_pid" ]; then
        pidfile_verified=1
      fi
    done
    if [ "$pidfile_verified" -eq 0 ]; then
      echo "Discarding a stale server PID file."
      rm -f "$PIDFILE"
    fi
  fi

  stop
  server_pids=$(recovery_server_pids)
  if [ -n "$server_pids" ]; then
    stop_recovery_servers
  fi
  if [ -n "$(recovery_server_pids)" ]; then
    echo "The orphaned toolkit server could not be stopped." >&2
    exit 1
  fi
  if ! port_available; then
    echo "Cannot recover: $HOST:$PORT is still in use." >&2
    show_recovery_listeners
    exit 1
  fi

  if [ "$(id -u)" -eq 0 ] && [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
    fix_permissions
    echo "Starting the toolkit as $SUDO_USER..."
    sudo -u "$SUDO_USER" -- "$ROOT/twn" start
    return
  fi
  start
}

fix_permissions() {
  if is_running; then
    echo "Stop the toolkit before repairing runtime permissions: ./twn stop" >&2
    exit 1
  fi
  if [ ! -d "$INSTANCE" ] && [ ! -e "$UPGRADE_WORKSPACE" ] && [ ! -e "$RELEASE_MANIFEST" ]; then
    echo "No toolkit runtime files exist yet."
    return
  fi
  owner=$(id -un)
  group=$(id -gn)
  if [ "$(id -u)" -ne 0 ]; then
    echo "Repairing files created by sudo mode requires elevated permissions."
    echo "Run: sudo $0 fix-permissions"
    exit 1
  fi
  if [ -n "${SUDO_USER:-}" ]; then
    owner="$SUDO_USER"
    group=$(id -gn "$SUDO_USER")
  fi
  if [ -d "$INSTANCE" ]; then
    chown -R "$owner:$group" "$INSTANCE"
  fi
  if [ -e "$UPGRADE_WORKSPACE" ]; then
    chown -R "$owner:$group" "$UPGRADE_WORKSPACE"
  fi
  if [ -e "$RELEASE_MANIFEST" ]; then
    chown "$owner:$group" "$RELEASE_MANIFEST"
  fi
  echo "Repaired toolkit runtime permissions for $owner:$group."
}

reset_auth() {
  if is_running; then
    echo "Stop the toolkit before resetting authentication: ./twn stop" >&2
    exit 1
  fi
  if [ ! -f "$INSTANCE/auth.json" ]; then
    echo "Authentication is already unconfigured."
    return
  fi
  printf "Delete all toolkit users and require first-launch setup again? [y/N] "
  read -r answer
  case "$answer" in
    y|Y|yes|YES)
      rm -f "$INSTANCE/auth.json"
      echo "Authentication reset. Run ./twn start, then open the toolkit to create a new administrator."
      ;;
    *)
      echo "Reset cancelled."
      ;;
  esac
}

reset_data() {
  if is_running; then
    echo "Stop the toolkit before resetting saved profile data: ./twn stop" >&2
    exit 1
  fi
  ensure_requirements
  cd "$ROOT"
  "$PYTHON" -m flask --app twn_toolkit reset-data "$@"
}

web_restart() {
  sleep 2
  if "$0" restart; then
    rm -f "$PREVIOUS_SERVER_SETTINGS"
    return
  fi

  echo "Restart with new server settings failed; restoring the previous settings." >&2
  if [ -f "$PREVIOUS_SERVER_SETTINGS" ]; then
    cp "$PREVIOUS_SERVER_SETTINGS" "$SERVER_SETTINGS"
  fi
  if "$0" start; then
    rm -f "$PREVIOUS_SERVER_SETTINGS"
  fi
}

launchd_run() {
  launchd_worker_role=${1:-}
  if ! launchd_direct_job; then
    echo "launchd-run is reserved for the installed macOS LaunchDaemon jobs." >&2
    return 2
  fi
  if [ -n "$LAUNCHD_ROLE" ] && [ "$LAUNCHD_ROLE" != "$launchd_worker_role" ]; then
    echo "The launchd role does not match the requested worker." >&2
    return 2
  fi
  if [ -f "$SERVICE_PAUSE_FILE" ]; then return 0; fi
  case "$launchd_worker_role" in
    web|automation|supervisor)
      [ -f "$SERVICE_LAUNCHD_MARKER" ] || return 0
      ;;
  esac

  mkdir -p "$INSTANCE"
  cd "$ROOT"
  case "$launchd_worker_role" in
    web)
      configure_tls
      if [ ! -x "$GUNICORN" ]; then
        echo "Gunicorn is not installed. Run: .venv/bin/pip install -r requirements.txt" >&2
        return 1
      fi
      if ! port_available; then
        echo "Cannot start the direct web daemon: $HOST:$PORT is already in use." >&2
        return 1
      fi
      rm -f "$PIDFILE"
      printf "%s\n" "$SCHEME" > "$SCHEME_FILE"
      printf "%s\n" "$HOST" > "$HOST_FILE"
      printf "%s\n" "$PORT" > "$PORT_FILE"
      web_generation_temporary="$SERVICE_WEB_GENERATION_FILE.$$"
      printf "%s.%s\n" "$(date +%s)" "$$" > "$web_generation_temporary"
      chmod 600 "$web_generation_temporary"
      mv "$web_generation_temporary" "$SERVICE_WEB_GENERATION_FILE"
      set -- "$GUNICORN" \
        --bind "$HOST:$PORT" \
        --workers "$WORKERS" \
        --timeout 3700 \
        --pid "$PIDFILE" \
        --access-logfile "$ACCESS_LOG" \
        --error-logfile "$ERROR_LOG" \
        --capture-output
      if [ "$SCHEME" = "https" ]; then
        set -- "$@" --certfile "$TLS_CERT" --keyfile "$TLS_KEY"
        export TWN_TOOLKIT_HTTPS=1
      else
        unset TWN_TOOLKIT_HTTPS 2>/dev/null || true
      fi
      set -- "$@" "twn_toolkit:create_app()"
      exec "$@"
      ;;
    automation)
      rm -f "$AUTOMATION_PIDFILE"
      exec "$PYTHON" -m twn_toolkit.automation_worker \
        --instance "$INSTANCE" \
        --pid-file "$AUTOMATION_PIDFILE" \
        --log-file "$AUTOMATION_LOG"
      ;;
    supervisor)
      rm -f "$SUPERVISOR_PIDFILE"
      exec "$PYTHON" -m twn_toolkit.supervisor_worker \
        --instance "$INSTANCE" \
        --root "$ROOT" \
        --pid-file "$SUPERVISOR_PIDFILE" \
        --log-file "$SUPERVISOR_LOG"
      ;;
    tftp)
      [ -f "$TFTP_LAUNCHD_MARKER" ] && managed_worker_enabled "$TFTP_SETTINGS" || {
        rm -f "$TFTP_LAUNCHD_MARKER"; return 0;
      }
      rm -f "$TFTP_PIDFILE" "$TFTP_READYFILE"
      exec "$PYTHON" -m twn_toolkit.tftp_worker \
        --instance "$INSTANCE" \
        --pid-file "$TFTP_PIDFILE" \
        --ready-file "$TFTP_READYFILE" \
        --log-file "$TFTP_LOG"
      ;;
    ssh-transfer)
      [ -f "$SSH_TRANSFER_LAUNCHD_MARKER" ] && managed_worker_enabled "$SSH_TRANSFER_SETTINGS" || {
        rm -f "$SSH_TRANSFER_LAUNCHD_MARKER"; return 0;
      }
      rm -f "$SSH_TRANSFER_PIDFILE" "$SSH_TRANSFER_READYFILE"
      exec "$PYTHON" -m twn_toolkit.ssh_transfer_worker \
        --instance "$INSTANCE" \
        --pid-file "$SSH_TRANSFER_PIDFILE" \
        --ready-file "$SSH_TRANSFER_READYFILE" \
        --log-file "$SSH_TRANSFER_LOG"
      ;;
    ftp)
      [ -f "$FTP_LAUNCHD_MARKER" ] && managed_worker_enabled "$FTP_SETTINGS" || {
        rm -f "$FTP_LAUNCHD_MARKER"; return 0;
      }
      rm -f "$FTP_PIDFILE" "$FTP_READYFILE"
      exec "$PYTHON" -m twn_toolkit.ftp_worker \
        --instance "$INSTANCE" \
        --pid-file "$FTP_PIDFILE" \
        --ready-file "$FTP_READYFILE" \
        --log-file "$FTP_LOG"
      ;;
    *)
      echo "Unknown launchd worker role: $launchd_worker_role" >&2
      return 2
      ;;
  esac
}

direct_process_set_ready() {
  is_running && automation_is_running && supervisor_is_running \
    && [ -f "$SCHEME_FILE" ] && [ -f "$HOST_FILE" ] && [ -f "$PORT_FILE" ]
}

wait_for_direct_process_set() {
  direct_wait_attempts=0
  while [ "$direct_wait_attempts" -lt 50 ]; do
    if direct_process_set_ready; then return; fi
    direct_wait_attempts=$((direct_wait_attempts + 1))
    sleep 0.1
  done

  # A final validation worker can exit while launchd is recreating its direct
  # replacement. If its PID marker is lost in that handoff, stop the exact
  # untracked process so launchd gives it a fresh marker-owning generation.
  if ! automation_is_running; then
    cleanup_worker_processes "twn_toolkit.automation_worker" 0
  fi
  if ! supervisor_is_running; then
    cleanup_duplicate_supervisors 0
  fi

  direct_wait_attempts=0
  while [ "$direct_wait_attempts" -lt 100 ]; do
    if direct_process_set_ready; then return; fi
    direct_wait_attempts=$((direct_wait_attempts + 1))
    sleep 0.1
  done
  return 1
}

mark_direct_web_generation() {
  direct_process_set_ready || return 0
  direct_web_generation=$(cat "$SERVICE_WEB_GENERATION_FILE" 2>/dev/null || true)
  marked_web_generation=$(cat "$SERVICE_MARKED_WEB_GENERATION_FILE" 2>/dev/null || true)
  if [ -z "$direct_web_generation" ] || [ "$direct_web_generation" = "$marked_web_generation" ]; then
    return 0
  fi
  "$PYTHON" -m twn_toolkit.system_identity mark-start --instance "$INSTANCE" >/dev/null
  marked_generation_temporary="$SERVICE_MARKED_WEB_GENERATION_FILE.$$"
  printf "%s\n" "$direct_web_generation" > "$marked_generation_temporary"
  chmod 600 "$marked_generation_temporary"
  mv "$marked_generation_temporary" "$SERVICE_MARKED_WEB_GENERATION_FILE"
}

service_run_direct() {
  clear_stale_direct_service_pause
  sync_launchd_transfer_markers
  rm -f "$SERVICE_RESUME_FILE"
  echo "The toolkit coordinator is monitoring direct launchd jobs."
  while :; do
    recorded_launcher_pid=$(cat "$SERVICE_LAUNCHER_PIDFILE" 2>/dev/null || true)
    if [ "$recorded_launcher_pid" != "$$" ]; then
      echo "The direct launchd coordinator was withheld for reload." >&2
      return 1
    fi
    if [ -f "$SERVICE_PAUSE_FILE" ]; then
      sync_launchd_transfer_markers
      sleep 1
      continue
    fi
    if [ -f "$SERVICE_RESUME_FILE" ]; then
      rm -f "$SERVICE_RESUME_FILE"
    fi
    sync_launchd_transfer_markers
    mark_direct_web_generation
    sleep 2
  done
}

remove_own_service_launcher_pid() {
  recorded_launcher_pid=$(cat "$SERVICE_LAUNCHER_PIDFILE" 2>/dev/null || true)
  if [ "$recorded_launcher_pid" = "$$" ]; then rm -f "$SERVICE_LAUNCHER_PIDFILE"; fi
}

service_run_cleanup() {
  service_exit_status=$?
  trap - EXIT INT TERM
  if launchd_direct_job; then
    remove_own_service_launcher_pid
    rm -f "$SERVICE_DEFERRED_RELOAD_PIDFILE"
    exit "$service_exit_status"
  fi
  SERVICE_RUN_MODE=1
  if [ -f "$UPGRADE_OPERATION_LOCK" ] && [ -f "$SERVICE_PAUSE_FILE" ]; then
    # An upgrade validation process set may be running outside this service
    # cgroup. Do not tear it down or discard the durable pause if the OS
    # supervisor itself is restarted during the handoff.
    remove_own_service_launcher_pid
    exit "$service_exit_status"
  fi
  stop || true
  rm -f "$SERVICE_LAUNCHER_PIDFILE" "$SERVICE_PAUSE_FILE" "$SERVICE_RESUME_FILE" \
    "$SERVICE_DEFERRED_RELOAD_PIDFILE"
  exit "$service_exit_status"
}

service_run() {
  if service_launcher_is_running; then
    recorded_launcher_pid=$(cat "$SERVICE_LAUNCHER_PIDFILE")
    if [ "$recorded_launcher_pid" != "$$" ]; then
      echo "The toolkit autostart supervisor is already running (PID $recorded_launcher_pid)." >&2
      return 1
    fi
  fi
  mkdir -p "$INSTANCE"
  printf "%s\n" "$$" > "$SERVICE_LAUNCHER_PIDFILE"
  chmod 600 "$SERVICE_LAUNCHER_PIDFILE"
  if launchd_direct_job; then
    rm -f "$SERVICE_DEFERRED_RELOAD_PIDFILE"
  elif [ -f "$UPGRADE_OPERATION_LOCK" ]; then
    write_service_pause_marker
    rm -f "$SERVICE_RESUME_FILE"
  else
    rm -f "$SERVICE_PAUSE_FILE" "$SERVICE_RESUME_FILE" "$SERVICE_DEFERRED_RELOAD_PIDFILE"
  fi
  SERVICE_RUN_MODE=1
  TWN_TOOLKIT_SERVICE_RUN=1
  export TWN_TOOLKIT_SERVICE_RUN
  trap service_run_cleanup EXIT
  trap 'exit 0' INT TERM

  if launchd_direct_job; then
    service_run_direct
    return
  fi

  start
  echo "The toolkit autostart supervisor is monitoring the managed process set."
  while :; do
    if [ -f "$SERVICE_PAUSE_FILE" ]; then
      sleep 1
      continue
    fi
    if [ -f "$SERVICE_RESUME_FILE" ]; then
      rm -f "$SERVICE_RESUME_FILE"
      start
      continue
    fi
    if ! is_running; then
      echo "The toolkit web process exited unexpectedly; requesting a service-manager restart." >&2
      return 1
    fi
    sleep 2
  done
}

service_control() {
  service_action=${1:-status}
  if [ "$#" -gt 0 ]; then shift; fi
  case "$service_action" in
    install)
      cd "$ROOT"
      "$PYTHON" -m twn_toolkit.service_cli --root "$ROOT" install --validate-only "$@" || return 1
      if [ "$(id -u)" -ne 0 ] && has_instance_permission_issues; then
        offer_permission_repair || return 1
      fi
      if is_running && ! service_launcher_is_running; then stop; fi
      ;;
    uninstall|start|stop|restart)
      ;;
    status|logs)
      cd "$ROOT"
      "$PYTHON" -m twn_toolkit.service_cli --root "$ROOT" "$service_action" "$@"
      return
      ;;
    *)
      echo "Usage: ./twn service {install|uninstall|start|stop|restart|status|logs}" >&2
      return 2
      ;;
  esac

  if [ "$(id -u)" -ne 0 ]; then
    if ! command -v sudo >/dev/null 2>&1; then
      echo "This service-manager operation requires root, but sudo is unavailable." >&2
      return 1
    fi
    exec sudo "$PYTHON" -m twn_toolkit.service_cli --root "$ROOT" "$service_action" "$@"
  fi
  cd "$ROOT"
  "$PYTHON" -m twn_toolkit.service_cli --root "$ROOT" "$service_action" "$@"
}

case "${1:-}" in
  start)
    start
    ;;
  stop)
    stop
    ;;
  restart)
    stop
    start
    ;;
  recover)
    recover
    ;;
  status)
    status
    ;;
  logs)
    logs
    ;;
  fix-permissions)
    fix_permissions
    ;;
  adminreset|reset-auth)
    reset_auth
    ;;
  reset-data)
    shift
    reset_data "$@"
    ;;
  upgrade)
    shift
    ensure_requirements
    "$PYTHON" -m twn_toolkit.upgrade_cli --root "$ROOT" --instance "$INSTANCE" upgrade "$@"
    ;;
  backup)
    shift
    ensure_requirements
    "$PYTHON" -m twn_toolkit.upgrade_cli --root "$ROOT" --instance "$INSTANCE" backup "$@"
    ;;
  rollback)
    shift
    ensure_requirements
    "$PYTHON" -m twn_toolkit.upgrade_cli --root "$ROOT" --instance "$INSTANCE" rollback "$@"
    ;;
  upgrade-status)
    ensure_requirements
    "$PYTHON" -m twn_toolkit.upgrade_cli --root "$ROOT" --instance "$INSTANCE" status
    ;;
  prepare-upgrade-service-reload)
    prepare_upgrade_service_reload
    ;;
  multicast-pf)
    shift
    if [ ! -x "$PYTHON" ]; then
      echo "Python virtual environment is missing. Run: ./install.sh" >&2
      exit 1
    fi
    cd "$ROOT"
    "$PYTHON" -m twn_toolkit.macos_multicast_pf_cli "$@"
    ;;
  web-restart)
    web_restart
    ;;
  tftp-restart)
    tftp_restart
    ;;
  ssh-transfer-restart)
    ssh_transfer_restart
    ;;
  ftp-restart)
    ftp_restart
    ;;
  automation-restart)
    automation_restart
    ;;
  service)
    shift
    service_control "$@"
    ;;
  service-run)
    service_run
    ;;
  launchd-run)
    shift
    launchd_run "$@"
    ;;
  enable-https)
    shift
    enable_https "$@"
    ;;
  disable-https)
    disable_https
    ;;
  *)
    echo "Usage: ./twn {start|stop|restart|recover|status|logs|service|upgrade|backup|rollback|upgrade-status|multicast-pf|enable-https|disable-https|fix-permissions|adminreset|reset-data|automation-restart|tftp-restart|ssh-transfer-restart|ftp-restart}" >&2
    exit 2
    ;;
esac
